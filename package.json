  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhylthyme/rhylthyme-mcp.git"
  },
  "homepage": "https://github.com/rhylthyme/rhylthyme-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "mcp-handler": "^1.0.7",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
