{
  "version": 2,
  "builds": [
    {
      "src": "mcp-api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 180,
        "includeFiles": "mcp-api/fonts/**"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/mcp-api"
    },
    {
      "source": "/.well-known/oauth-protected-resource/(.*)",
      "destination": "/mcp-api"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/mcp-api"
    },
    {
      "source": "/mcp",
      "destination": "/mcp-api"
    },
    {
      "source": "/kitchen/mcp",
      "destination": "/mcp-api"
    },
    {
      "source": "/lab/mcp",
      "destination": "/mcp-api"
    },
    {
      "source": "/events/mcp",
      "destination": "/mcp-api"
    },
    {
      "source": "/gym/mcp",
      "destination": "/mcp-api"
    },
    {
      "source": "/api/og/timeline.png",
      "destination": "/mcp-api"
    }
  ]
}
